{
  "name": "nuxt-next-ecommerce-comparison",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22 <23",
    "npm": "10.9.8"
  },
  "scripts": {
    "data:csv-validate": "node scripts/validate-manual-csv.mjs",
    "data:convert": "node scripts/convert-manual-products.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "data:download-images": "node scripts/download-product-images.mjs",
    "data:normalize-images": "node scripts/normalize-product-images.mjs",
    "data:sync": "node scripts/sync-data.mjs",
    "data:verify": "node scripts/verify-data.mjs",
    "data:report": "node scripts/write-data-report.mjs",
    "data:prepare": "npm run data:csv-validate && npm run data:convert && npm run data:download-images && npm run data:normalize-images && npm run data:validate && npm run data:sync && npm run data:verify && npm run data:report",
    "test:data": "node --test scripts/data-utils.test.mjs",
    "test:parity-snapshot": "node scripts/check-snapshot-integrity.mjs",
    "experimental:summarize": "node scripts/summarize-experimental-results.mjs"
  },
  "devDependencies": {
    "sharp": "0.35.3"
  }
}
